[MASTER]
# 忽略的文件或目录
ignore=.git,.pytest_cache,.hypothesis,__pycache__,build,dist,.vscode,.kiro,htmlcov,.ruff_cache
ignore-patterns=.*_pb2\.py$,.*\.pyx$

# 忽略的模块（动态生成，会产生误报）
# 使用新的配置项名称
extension-pkg-allow-list=cv2,PySide6

# 使用多进程加速
jobs=0

[MESSAGES CONTROL]
# 禁用的检查
disable=
    C0103,  # invalid-name (Qt 使用驼峰命名)
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring
    C0301,  # line-too-long (已由 Ruff 处理)
    C0302,  # too-many-lines (主窗口和面板类功能复杂)
    C0305,  # trailing-newlines (已由 Ruff 处理)
    C0325,  # superfluous-parens (已由 Ruff 处理)
    C0413,  # wrong-import-position (Qt 延迟导入是必要的)
    C0415,  # import-outside-toplevel (Qt 延迟导入是必要的)
    E0611,  # no-name-in-module (PySide6 动态生成，误报)
    E1101,  # no-member (PySide6/cv2 动态生成，通过 extension-pkg-allow-list 处理)
    R0801,  # duplicate-code (已手动检查，剩余重复是合理的)
    R0902,  # too-many-instance-attributes (Qt 类通常有很多属性)
    R0903,  # too-few-public-methods (某些类只需要少量方法)
    R0911,  # too-many-return-statements
    R0912,  # too-many-branches
    R0913,  # too-many-arguments (Qt 方法参数较多)
    R0914,  # too-many-locals
    R0915,  # too-many-statements
    R0917,  # too-many-positional-arguments
    R1702,  # too-many-nested-blocks
    R1705,  # no-else-return (有时 elif 更清晰)
    R1714,  # consider-using-in
    W0101,  # unreachable (有时是防御性代码)
    W0104,  # pointless-statement
    W0107,  # unnecessary-pass
    W0201,  # attribute-defined-outside-init (Qt 动态属性是常见的)
    W0212,  # protected-access (Qt 内部访问)
    W0404,  # reimported (有时需要局部导入)
    W0603,  # global-statement (单例模式需要)
    W0613,  # unused-argument (Qt 信号槽参数)
    W0621,  # redefined-outer-name (局部导入)
    W0622,  # redefined-builtin
    W0718,  # broad-exception-caught (顶层异常处理是必要的)
    E0203,  # access-member-before-definition (Qt 动态属性)

[FORMAT]
# 最大行长度
max-line-length=120

# 缩进
indent-string='    '

[DESIGN]
# 最大参数数量
max-args=10

# 最大属性数量
max-attributes=15

# 最小相似行数（用于检测重复代码）
min-similarity-lines=6

[SIMILARITIES]
# 忽略注释
ignore-comments=yes

# 忽略文档字符串
ignore-docstrings=yes

# 忽略导入
ignore-imports=yes

# 最小重复行数
min-similarity-lines=6
