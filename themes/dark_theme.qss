/* 深色主题样式表 */

/* ========== 全局样式 ========== */
QWidget {
    font-family: "Microsoft YaHei", "SimHei", Arial, sans-serif;
    font-size: 12px;
    color: #cccccc;
    background-color: #1e1e1e;
}

QMainWindow {
    background-color: #1e1e1e;
}

/* ========== 工具栏样式 ========== */
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #2d2d2d, stop:1 #252525);
    border-top: 1px solid #3e3e3e;
    border-bottom: 1px solid #3e3e3e;
    border-left: none;
    border-right: none;
    padding: 0;
}

/* 工具栏按钮组容器 */
QFrame#toolbarButtonGroup {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
}

/* 视图模式切换器容器 */
QFrame#viewModeSwitcher {
    background-color: rgba(255, 255, 255, 0.05);
    border: none;
    border-radius: 6px;
}

/* 视图模式切换器按钮 */
QFrame#viewModeSwitcher QPushButton {
    background-color: transparent;
    color: #cccccc;
    font-weight: 500;
    font-size: 12px;
    padding: 4px 12px;
    border: none;
    border-radius: 4px;
    min-width: 50px;
}

QFrame#viewModeSwitcher QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QFrame#viewModeSwitcher QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.12);
}

QFrame#viewModeSwitcher QPushButton:checked {
    background-color: transparent;
    color: #6eb3ff;
    font-weight: 600;
}

/* 工具栏容器中的按钮 - 扁平无边框样式 */
QToolBar QWidget QPushButton {
    background-color: transparent;
    color: #cccccc;
    font-weight: 500;
    font-size: 12px;
    padding: 4px 6px;
    border: none;
    border-radius: 4px;
    min-width: 36px;
}

QToolBar QWidget QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QToolBar QWidget QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.12);
}

QToolBar QWidget QPushButton:checked {
    background-color: rgba(110, 179, 255, 0.2);
    color: #6eb3ff;
}

QToolBar QWidget QPushButton:disabled {
    background-color: transparent;
    color: #666666;
}

/* 工具栏标签 */
QToolBar QLabel {
    color: #999999;
    font-size: 11px;
    padding: 0 8px;
}

/* ========== 按钮样式 ========== */
QPushButton {
    background-color: #3a3a3a;
    color: #e0e0e0;
    font-weight: 500;
    padding: 8px 16px;
    border: 1px solid #4a4a4a;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #454545;
    border-color: #5a5a5a;
}

QPushButton:pressed {
    background-color: #505050;
    border-color: #6a6a6a;
}

QPushButton:disabled {
    background-color: #2a2a2a;
    color: #666666;
    border-color: #3a3a3a;
}

/* ========== 输入框样式 ========== */
QLineEdit {
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: #2a2a2a;
    color: #e0e0e0;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

QLineEdit:hover {
    border-color: #5a5a5a;
}

QLineEdit:focus {
    border-color: #0078d4;
    background-color: #2d2d2d;
}

/* ========== 分组框样式 ========== */
QGroupBox {
    font-weight: bold;
    font-size: 14px;
    color: #e0e0e0;
    border: 1px solid #404040;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: #1e1e1e;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    top: 0px;
    padding: 0 4px;
    background-color: #1e1e1e;
    color: #e0e0e0;
}

/* ========== 滑块样式 ========== */
QSlider::groove:horizontal {
    border: 1px solid #4a4a4a;
    height: 6px;
    background: #2a2a2a;
    margin: 2px 0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #6eb3ff, stop:1 #4a9eff);
    border: 1px solid #3a8eef;
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #7ec3ff, stop:1 #6eb3ff);
}

/* ========== 复选框样式 ========== */
QCheckBox {
    spacing: 8px;
    color: #e0e0e0;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    border: 2px solid #5a5a5a;
    background-color: #2a2a2a;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    border: 2px solid #0078d4;
    background-color: #0078d4;
    border-radius: 3px;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTIiIGhlaWdodD0iMTIiIHZpZXdCb3g9IjAgMCAxMiAxMiIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNMTAgMkw0LjUgNy41TDIgNSIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIyIiBmaWxsPSJub25lIi8+PC9zdmc+);
}

/* ========== 单选按钮样式 ========== */
QRadioButton {
    spacing: 8px;
    color: #e0e0e0;
}

QRadioButton::indicator {
    width: 8px;
    height: 8px;
}

QRadioButton::indicator:unchecked {
    border: 2px solid #5a5a5a;
    background-color: #2a2a2a;
    border-radius: 6px;
}

QRadioButton::indicator:checked {
    border: 2px solid #0078d4;
    background-color: #0078d4;
    border-radius: 6px;
}

/* ========== 下拉框样式 ========== */
QComboBox {
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: #2a2a2a;
    color: #e0e0e0;
    min-height: 24px;
    selection-background-color: #0078d4;
}

QComboBox:hover {
    border-color: #5a5a5a;
}

QComboBox:focus {
    border-color: #0078d4;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: url({{THREE_BARS_ICON_PATH}});
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    border: 1px solid #4a4a4a;
    background-color: #2a2a2a;
    color: #e0e0e0;
    selection-background-color: #0078d4;
    selection-color: white;
}

/* 自定义下拉框视图 */
QListView#customComboBoxView {
    border: 1px solid #4a4a4a;
    background-color: #2a2a2a;
    outline: none;
}

/* ========== 标签样式 ========== */
QLabel {
    color: #cccccc;
}

/* ========== 进度条样式 ========== */
QProgressBar {
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    text-align: center;
    background-color: #2a2a2a;
    color: #e0e0e0;
    height: 20px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #6eb3ff, stop:1 #4a9eff);
    border-radius: 3px;
}

/* ========== 分割线样式 ========== */
QSplitter::handle {
    background-color: #3e3e3e;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ========== 滚动条样式 ========== */
QScrollBar:vertical {
    border: none;
    background: #1e1e1e;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #4a4a4a;
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #5a5a5a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #1e1e1e;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #4a4a4a;
    min-width: 30px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #5a5a5a;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ========== 状态栏样式 ========== */
QStatusBar {
    background-color: #252525;
    color: #999999;
    border-top: 1px solid #3e3e3e;
    padding: 4px 8px;
}

/* ========== 数字输入框样式 ========== */
QSpinBox, QDoubleSpinBox {
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: #2a2a2a;
    color: #e0e0e0;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #5a5a5a;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #0078d4;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    border: none;
    background-color: transparent;
    width: 16px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    border: none;
    background-color: transparent;
    width: 16px;
}

/* ========== 面板样式 ========== */
QFrame {
    border: none;
    background-color: #1e1e1e;
}

QFrame[frameShape="4"] { /* HLine */
    background-color: #3e3e3e;
    max-height: 1px;
}

QFrame[frameShape="5"] { /* VLine */
    background-color: #3e3e3e;
    max-width: 1px;
}

/* ========== 选项卡样式 ========== */
QTabWidget::pane {
    border: 1px solid #404040;
    border-radius: 4px;
    background: #2a2a2a;
    top: -1px;
}

QTabBar::tab {
    background: #1e1e1e;
    color: #999999;
    padding: 8px 20px;
    margin-right: 4px;
    border: 1px solid #404040;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-size: 13px;
}

QTabBar::tab:selected {
    background: #2a2a2a;
    color: #e0e0e0;
    font-weight: bold;
    border-bottom: 1px solid #2a2a2a;
    margin-bottom: -1px;
}

QTabBar::tab:hover:!selected {
    background: #252525;
    color: #cccccc;
}

/* ========== 侧边栏面板样式 ========== */
QScrollArea {
    background-color: #1e1e1e;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #1e1e1e;
}

/* ========== 视图切换器指示器（深色主题） ========== */
QWidget#viewModeSwitcherIndicator {
    background-color: rgba(110, 179, 255, 0.25);
    border-radius: 4px;
}

/* ========== 视图切换器容器（深色主题） ========== */
QWidget#viewModeContainer {
    background-color: #2a2a2a;
    border-radius: 8px;
}

/* ========== 当前图层容器（深色主题） ========== */
QWidget#currentLayerContainer {
    background-color: #2a2a2a;
    border-radius: 8px;
}

QLabel#currentLayerLabel {
    font-weight: bold;
    font-size: 12px;
    color: #e0e0e0;
    background-color: rgb(52, 52, 52);
    border-radius: 4px;
    padding: 6px 12px;
}

/* ========== 二值化面板选项卡样式（深色主题） ========== */
QTabWidget#binarizationPanelTabs::pane {
    border: 1px solid #404040;
    background-color: #1e1e1e;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    margin-top: 0px;
}

QTabWidget#binarizationPanelTabs QTabBar::tab {
    background-color: #252525;
    color: #999999;
    padding: 8px 16px;
    margin-right: 2px;
    margin-top: 4px;
    border: 1px solid #404040;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabWidget#binarizationPanelTabs QTabBar::tab:selected {
    background-color: #1e1e1e;
    color: #6eb3ff;
    font-weight: bold;
    border: 1px solid #404040;
    border-bottom: 1px solid #1e1e1e;
    margin-top: 4px;
}

QTabWidget#binarizationPanelTabs QTabBar::tab:hover:!selected {
    background-color: #2a2a2a;
    color: #cccccc;
}

/* ========== 属性面板内容样式 ========== */
QWidget#propertiesPanelContent {
    background-color: #1e1e1e;
    border-radius: 8px;
}

/* 属性面板选项卡样式 */
QWidget#propertiesPanelContent QTabWidget::pane {
    border: 1px solid #404040;
    border-radius: 4px;
    background: #1e1e1e;
    top: -1px;
}

QWidget#propertiesPanelContent QTabBar::tab {
    background: #252525;
    color: #999999;
    padding: 8px 20px;
    margin-right: 4px;
    border: 1px solid #404040;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-size: 13px;
}

QWidget#propertiesPanelContent QTabBar::tab:selected {
    background: #1e1e1e;
    color: #e0e0e0;
    font-weight: bold;
    border-bottom: 1px solid #1e1e1e;
    margin-bottom: -1px;
}

QWidget#propertiesPanelContent QTabBar::tab:hover:!selected {
    background: #2a2a2a;
    color: #cccccc;
}

/* 属性面板内的标签文字 */
QWidget#propertiesPanelContent QLabel {
    color: #999999;
}

/* 属性面板内的属性值（右侧内容） */
QLabel#propertyValue {
    color: #ffffff;
}

/* 工具提示文字 */
QLabel#toolHint {
    color: #999999;
    padding: 20px;
}

/* 属性面板内的分组框 */
QWidget#propertiesPanelContent QGroupBox {
    color: #f0f0f0;
    border-color: #404040;
    background-color: #1e1e1e;
}

QWidget#propertiesPanelContent QGroupBox::title {
    color: #f0f0f0;
    background-color: #1e1e1e;
}


/* ========== 重置按钮样式（深色主题） ========== */
QPushButton[fixedSize="24"] {
    border: none;
    background-color: transparent;
    padding: 2px;
}

QPushButton[fixedSize="24"]:hover {
    background-color: #404040;
    border-radius: 4px;
}

QPushButton[fixedSize="24"]:pressed {
    background-color: #505050;
    border-radius: 4px;
}

/* ========== 设置对话框样式 ========== */
QDialog {
    background-color: #1e1e1e;
}

QDialog QGroupBox {
    color: #e8e8e8;
    border-color: #404040;
    background-color: transparent;
}

QDialog QGroupBox::title {
    color: #e8e8e8;
    background-color: transparent;
}

QDialog QLabel {
    color: #e0e0e0;
    background-color: transparent;
}

/* 设置对话框选项卡 */
QTabWidget#settingsTabWidget::pane {
    border: 1px solid #404040;
    border-radius: 4px;
    background: #1e1e1e;
    top: -1px;
}

QTabWidget#settingsTabWidget QTabBar::tab {
    background: #252525;
    color: #999999;
    padding: 8px 20px;
    margin-right: 4px;
    border: 1px solid #404040;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-size: 13px;
}

QTabWidget#settingsTabWidget QTabBar::tab:selected {
    background: #1e1e1e;
    color: #e0e0e0;
    font-weight: bold;
    border-bottom: 1px solid #1e1e1e;
    margin-bottom: -1px;
}

QTabWidget#settingsTabWidget QTabBar::tab:hover:!selected {
    background: #2a2a2a;
    color: #cccccc;
}

/* 设置对话框按钮容器 */
QWidget#settingsButtonContainer {
    background: #252525;
    border-top: 1px solid #404040;
}

/* ========== 关于对话框文字样式 ========== */
QLabel#aboutSeparator {
    border-top: 1px solid #505050;
    background-color: transparent;
}

QLabel#aboutAppName {
    color: #f5f5f5;
    background-color: transparent;
}

QLabel#aboutVersion {
    color: #e8e8e8;
    background-color: transparent;
}

QLabel#aboutDate {
    color: #e0e0e0;
    background-color: transparent;
}

QLabel#aboutDesc {
    color: #d8d8d8;
    background-color: transparent;
}

QLabel#aboutAuthor {
    color: #d8d8d8;
    background-color: transparent;
}

QLabel#aboutCopyright {
    color: #d0d0d0;
    background-color: transparent;
}

QLabel#aboutLicense {
    color: #d0d0d0;
    background-color: transparent;
}

/* ========== 当前工具标签 ========== */
QLabel#currentToolLabel {
    color: #cccccc;
}

