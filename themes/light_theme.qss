/* 浅色主题样式表 */

/* ========== 全局样式 ========== */
QWidget {
    font-family: "Microsoft YaHei", "SimHei", Arial, sans-serif;
    font-size: 12px;
}

QMainWindow {
    background-color: #f5f5f5;
}

/* ========== 工具栏样式 ========== */
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #ffffff, stop:1 #f8f9fa);
    border-top: 1px solid #dee2e6;
    border-bottom: 1px solid #dee2e6;
    border-left: none;
    border-right: none;
    padding: 0;
}

/* 工具栏按钮组容器 */
QFrame#toolbarButtonGroup {
    background-color: rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
}

/* 视图模式切换器容器 */
QFrame#viewModeSwitcher {
    background-color: rgba(0, 0, 0, 0.03);
    border: none;
    border-radius: 6px;
}

/* 视图模式切换器按钮 */
QFrame#viewModeSwitcher QPushButton {
    background-color: transparent;
    color: #495057;
    font-weight: 500;
    font-size: 12px;
    padding: 4px 12px;
    border: none;
    border-radius: 4px;
    min-width: 50px;
}

QFrame#viewModeSwitcher QPushButton:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

QFrame#viewModeSwitcher QPushButton:pressed {
    background-color: rgba(0, 0, 0, 0.1);
}

QFrame#viewModeSwitcher QPushButton:checked {
    background-color: transparent;
    color: #4a86e8;
    font-weight: 600;
}

/* 工具栏容器中的按钮 - 扁平无边框样式 */
QToolBar QWidget QPushButton {
    background-color: transparent;
    color: #495057;
    font-weight: 500;
    font-size: 12px;
    padding: 4px 6px;
    border: none;
    border-radius: 4px;
    min-width: 36px;
}

QToolBar QWidget QPushButton:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

QToolBar QWidget QPushButton:pressed {
    background-color: rgba(0, 0, 0, 0.1);
}

QToolBar QWidget QPushButton:checked {
    background-color: rgba(74, 134, 232, 0.15);
    color: #4a86e8;
}

QToolBar QWidget QPushButton:disabled {
    background-color: transparent;
    color: #adb5bd;
}

/* 工具栏标签 */
QToolBar QLabel {
    color: #6c757d;
    font-size: 11px;
    padding: 0 8px;
}

/* ========== 按钮样式 ========== */
QPushButton {
    background-color: #f8f9fa;
    color: #495057;
    font-weight: 500;
    padding: 8px 16px;
    border: 1px solid #dee2e6;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #e9ecef;
    border-color: #adb5bd;
}

QPushButton:pressed {
    background-color: #dee2e6;
    border-color: #6c757d;
}

QPushButton:disabled {
    background-color: #e9ecef;
    color: #adb5bd;
    border-color: #e9ecef;
}

/* ========== 输入框样式 ========== */
QLineEdit {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: #ffffff;
    selection-background-color: #007bff;
}

QLineEdit:hover {
    border-color: #adb5bd;
}

QLineEdit:focus {
    border-color: #007bff;
    background-color: #f0f7ff;
}

/* ========== 分组框样式 ========== */
QGroupBox {
    font-weight: bold;
    font-size: 14px;
    color: #495057;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    top: 0px;
    padding: 0 4px;
    background-color: #ffffff;
}

/* ========== 滑块样式 ========== */
QSlider::groove:horizontal {
    border: 1px solid #ced4da;
    height: 6px;
    background: #f8f9fa;
    margin: 2px 0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #4a86e8, stop:1 #357abd);
    border: 1px solid #2e6da4;
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #5a96f8, stop:1 #4a86e8);
}

/* ========== 复选框样式 ========== */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    border: 2px solid #ced4da;
    background-color: white;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    border: 2px solid #007bff;
    background-color: #007bff;
    border-radius: 3px;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTIiIGhlaWdodD0iMTIiIHZpZXdCb3g9IjAgMCAxMiAxMiIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNMTAgMkw0LjUgNy41TDIgNSIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIyIiBmaWxsPSJub25lIi8+PC9zdmc+);
}

/* ========== 单选按钮样式 ========== */
QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 8px;
    height: 8px;
}

QRadioButton::indicator:unchecked {
    border: 2px solid #ced4da;
    background-color: white;
    border-radius: 6px;
}

QRadioButton::indicator:checked {
    border: 2px solid #007bff;
    background-color: #007bff;
    border-radius: 6px;
}

/* ========== 下拉框样式 ========== */
QComboBox {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: white;
    min-height: 24px;
    selection-background-color: #007bff;
}

QComboBox:hover {
    border-color: #adb5bd;
}

QComboBox:focus {
    border-color: #007bff;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: url({{THREE_BARS_ICON_PATH}});
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    border: 1px solid #ced4da;
    background-color: white;
    selection-background-color: #007bff;
    selection-color: white;
}

/* 自定义下拉框视图 */
QListView#customComboBoxView {
    border: 1px solid #dee2e6;
    background-color: #ffffff;
    outline: none;
}

/* ========== 标签样式 ========== */
QLabel {
    color: #495057;
}

/* ========== 进度条样式 ========== */
QProgressBar {
    border: 1px solid #ced4da;
    border-radius: 4px;
    text-align: center;
    background-color: #f8f9fa;
    height: 20px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #4a86e8, stop:1 #357abd);
    border-radius: 3px;
}

/* ========== 分割线样式 ========== */
QSplitter::handle {
    background-color: #dee2e6;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ========== 滚动条样式 ========== */
QScrollBar:vertical {
    border: none;
    background: #f8f9fa;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #ced4da;
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #adb5bd;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #f8f9fa;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #ced4da;
    min-width: 30px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #adb5bd;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ========== 状态栏样式 ========== */
QStatusBar {
    background-color: #f8f9fa;
    color: #6c757d;
    border-top: 1px solid #dee2e6;
    padding: 4px 8px;
}

/* ========== 数字输入框样式 ========== */
QSpinBox, QDoubleSpinBox {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: white;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #adb5bd;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #007bff;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    border: none;
    background-color: transparent;
    width: 16px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    border: none;
    background-color: transparent;
    width: 16px;
}

/* ========== 面板样式 ========== */
QFrame {
    border: none;
}

QFrame[frameShape="4"] { /* HLine */
    background-color: #dee2e6;
    max-height: 1px;
}

QFrame[frameShape="5"] { /* VLine */
    background-color: #dee2e6;
    max-width: 1px;
}

/* ========== 视图切换器指示器 ========== */
QWidget#viewModeSwitcherIndicator {
    background-color: rgba(74, 134, 232, 0.2);
    border-radius: 4px;
}

/* ========== 视图切换器容器 ========== */
QWidget#viewModeContainer {
    background-color: #ffffff;
    border-radius: 8px;
}

/* ========== 当前图层容器 ========== */
QWidget#currentLayerContainer {
    background-color: #ffffff;
    border-radius: 8px;
}

QLabel#currentLayerLabel {
    font-weight: bold;
    font-size: 12px;
    color: #333333;
    background-color: rgb(248, 248, 248);
    border-radius: 4px;
    padding: 6px 12px;
}

/* ========== 二值化面板选项卡 ========== */
QTabWidget#binarizationPanelTabs::pane {
    border: none;
    background-color: #ffffff;
    border-top-left-radius: 0px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    margin-top: -1px;
}

QTabWidget#binarizationPanelTabs QTabBar::tab {
    background-color: #f8f9fa;
    color: #495057;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabWidget#binarizationPanelTabs QTabBar::tab:selected {
    background-color: #ffffff;
    color: #007bff;
    font-weight: bold;
}

QTabWidget#binarizationPanelTabs QTabBar::tab:hover:!selected {
    background-color: #e9ecef;
}

/* ========== 属性面板内容 ========== */
QWidget#propertiesPanelContent {
    background-color: #ffffff;
    border-radius: 8px;
}

/* 属性面板选项卡 */
QWidget#propertiesPanelContent QTabWidget::pane {
    border: 1px solid #dee2e6;
    border-radius: 4px;
    background: transparent;
    top: -1px;
}

QWidget#propertiesPanelContent QTabBar::tab {
    background: #f8f9fa;
    color: #6c757d;
    padding: 8px 20px;
    margin-right: 4px;
    border: 1px solid #dee2e6;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-size: 13px;
}

QWidget#propertiesPanelContent QTabBar::tab:selected {
    background: #ffffff;
    color: #495057;
    font-weight: bold;
    border-bottom: 1px solid #ffffff;
    margin-bottom: -1px;
}

QWidget#propertiesPanelContent QTabBar::tab:hover:!selected {
    background: #e9ecef;
}

/* ========== 关于对话框文字样式 ========== */
QLabel#aboutSeparator {
    border-top: 1px solid #dee2e6;
    background-color: transparent;
}

QLabel#aboutAppName {
    color: #212529;
}

QLabel#aboutVersion {
    color: #212529;
}

QLabel#aboutDate {
    color: #212529;
}

QLabel#aboutDesc {
    color: #212529;
}

QLabel#aboutAuthor {
    color: #212529;
}

QLabel#aboutCopyright {
    color: #212529;
}

QLabel#aboutLicense {
    color: #212529;
}

/* ========== 属性面板属性值样式 ========== */
QLabel#propertyValue {
    color: #333333;
}

QLabel#toolHint {
    color: #999999;
    padding: 20px;
}

/* ========== 当前工具标签 ========== */
QLabel#currentToolLabel {
    color: #495057;
}

/* ========== 设置对话框样式 ========== */
QTabWidget#settingsTabWidget::pane {
    border: 1px solid #dee2e6;
    border-radius: 4px;
    background: #ffffff;
    top: -1px;
}

QTabWidget#settingsTabWidget QTabBar::tab {
    background: #f8f9fa;
    color: #6c757d;
    padding: 8px 20px;
    margin-right: 4px;
    border: 1px solid #dee2e6;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-size: 13px;
}

QTabWidget#settingsTabWidget QTabBar::tab:selected {
    background: #ffffff;
    color: #495057;
    font-weight: bold;
    border-bottom: 1px solid #ffffff;
    margin-bottom: -1px;
}

QTabWidget#settingsTabWidget QTabBar::tab:hover:!selected {
    background: #e9ecef;
}

QWidget#settingsButtonContainer {
    background: #f8f9fa;
    border-top: 1px solid #dee2e6;
}

/* Reset Button */
QPushButton[fixedSize="24"] {
    border: none;
    background-color: transparent;
    padding: 2px;
}

QPushButton[fixedSize="24"]:hover {
    background-color: #e0e0e0;
    border-radius: 4px;
}

QPushButton[fixedSize="24"]:pressed {
    background-color: #d0d0d0;
}

/* ========== 模型下载对话框信息标签 ========== */
QLabel#infoLabel {
    color: #495057;
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 5px;
    padding: 10px;
}

QLabel#infoLabel a {
    color: #007bff;
    text-decoration: none;
}

QLabel#infoLabel a:hover {
    color: #0056b3;
    text-decoration: underline;
}
